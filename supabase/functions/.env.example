# Edge Function secrets. Copy to supabase/functions/.env for `supabase functions serve`
# (that file is gitignored). In prod they are set with `supabase secrets set`, never committed.

# Secret API key (`sb_secret_…`) used for the Admin API in delete-account.
# Locally: the SECRET_KEY value from `supabase status -o env`.
# Never use the legacy service_role key here.
SB_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated exact browser origins allowed by CORS (no trailing slash).
# Native apps send no Origin and don't need an entry.
ALLOWED_ORIGINS=http://localhost:8081
